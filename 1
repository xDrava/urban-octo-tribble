end

local function RB_DoFire(thead)
    local f = LP.Character and LP.Character:FindFirstChild("FighterCtrl")
    if f and f.UseItem then pcall(function() f:UseItem() end) end
    pcall(function()
        if RS.Remotes and RS.Remotes.Replication and RS.Remotes.Replication.Fighter and RS.Remotes.Replication.Fighter.UseItem then
            RS.Remotes.Replication.Fighter.UseItem:FireServer()
        end
    end)
end

local function EnableNoclip()
    if _s.noclipConn then return end
    _s.noclipConn = RunService.Stepped:Connect(function()
        local lc = LP.Character; if not lc then return end
        for _, p in lc:GetDescendants() do if p:IsA("BasePart") then p.CanCollide = false end end
    end)
end

local function DisableNoclip()
    if _s.noclipConn then _s.noclipConn:Disconnect(); _s.noclipConn = nil end
    local lc = LP.Character
    if lc then for _, p in lc:GetDescendants() do if p:IsA("BasePart") then p.CanCollide = true end end end
end

local function StopCsync()
    RunService:UnbindFromRenderStep("sh_csync")
    if _s.csyncConn then _s.csyncConn:Disconnect(); _s.csyncConn = nil end
    if _s.csyncHbConn then _s.csyncHbConn:Disconnect(); _s.csyncHbConn = nil end
    _s.csyncCF = nil; _s.csyncLocalCF = nil
end

local function StartCsync()
    StopCsync()
    _s.csyncHbConn = RunService.Heartbeat:Connect(function()
        local c = LP.Character; local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        _s.csyncLocalCF = h.CFrame
        _s.csyncLocalLV = h.AssemblyLinearVelocity
        _s.csyncLocalAV = h.AssemblyAngularVelocity
        if _s.csyncCF then
            h.CFrame = _s.csyncCF
            h.AssemblyLinearVelocity = _s.csyncLV or _fakev()
            h.AssemblyAngularVelocity = _s.csyncAV or _fakev()
        end
    end)
    RunService:BindToRenderStep("sh_csync", Enum.RenderPriority.First.Value, function()
        local c = LP.Character; local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h or not _s.csyncLocalCF then return end
        h.CFrame = _s.csyncLocalCF
        h.AssemblyLinearVelocity = _s.csyncLocalLV or Vector3.zero
        h.AssemblyAngularVelocity = _s.csyncLocalAV or Vector3.zero
    end)
end

local function DisableVoidCsync()
    if _s.rbVoidHbConn then _s.rbVoidHbConn:Disconnect(); _s.rbVoidHbConn = nil end
    RunService:UnbindFromRenderStep("sh_rbvoid")
    _s.rbVoidTargetCF = nil; _s.rbVoidThread = nil
end

local function EnableVoidCsync()
    DisableVoidCsync()
    _s.rbVoidHbConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local lc = LP.Character; local h = lc and lc:FindFirstChild("HumanoidRootPart")
            if not h then return end
            _voidSavedCF = h.CFrame; _voidSavedLV = h.AssemblyLinearVelocity; _voidSavedAV = h.AssemblyAngularVelocity
            if _s.rbVoidTargetCF then
                h.CFrame = _s.rbVoidTargetCF; h.AssemblyLinearVelocity = Vector3.zero; h.AssemblyAngularVelocity = Vector3.zero
            else
                h.CFrame = CFrame.new(_voidBR(), _voidBR(), _voidBR()) * CFrame.Angles(math.pi, math.pi, math.pi)
                h.AssemblyLinearVelocity = Vector3.new(_voidBR(), _voidBR(), _voidBR())
                h.AssemblyAngularVelocity = Vector3.new(_voidBR(), _voidBR(), _voidBR())
            end
        end)
    end)
    RunService:BindToRenderStep("sh_rbvoid", Enum.RenderPriority.First.Value, function()
        if not _voidSavedCF then return end
        pcall(function()
            local lc = LP.Character; local h = lc and lc:FindFirstChild("HumanoidRootPart")
            if not h then return end
            h.CFrame = _voidSavedCF; h.AssemblyLinearVelocity = _voidSavedLV; h.AssemblyAngularVelocity = _voidSavedAV
        end)
    end)
end

local function RB_StartVoidLoop()
    if _s.rbVoidThread then return end
    EnableVoidCsync()
    _s.rbVoidThread = task.spawn(function()
        while _s.rbActive and Toggles.RageBot.Value and Toggles.VoidMode.Value do
            if not _s.rbTarget or PlayerIsDead(_s.rbTarget) then
                _s.rbVoidTargetCF = nil; task.wait(0.05); continue
            end
            
            _s.rbVoidTargetCF = nil
            task.wait(Options.VoidHideTime.Value)
            
            local tgt = _s.rbTarget
            if tgt and not PlayerIsDead(tgt) then
                local tc = tgt.Character; local thead = tc and (tc:FindFirstChild("Head") or tc:FindFirstChild("HumanoidRootPart"))
                if thead then
                    _s.rbVoidTargetCF = CFrame.new(thead.Position)
                    task.wait(Options.VoidShootTime.Value)
                    RB_DoFire(thead)
                    _s.rbVoidTargetCF = nil
                end
            end
        end
        _s.rbVoidThread = nil; DisableVoidCsync()
    end)
end

local function StartRageBot()
    if _s.rbConn then _s.rbConn:Disconnect(); _s.rbConn = nil end
    DisableVoidCsync()
    _s.rbActive = true; _s.rbTarget = nil; _s.rbLastFakePos = nil; _s.orbitAngle = math.random() * (math.pi * 2)
    
    if Toggles.Noclip.Value then EnableNoclip() end
    if Toggles.Csync.Value or Toggles.KnifeFarm.Value then StartCsync() end

    if Toggles.VoidMode.Value then
        RB_StartVoidLoop()
        return 
    end

    _s.rbConn = RunService.Stepped:Connect(function(dt)
        if not _s.rbActive or not Toggles.RageBot.Value or not LP.Character then 
            if _s.rbConn then _s.rbConn:Disconnect(); _s.rbConn = nil end; return 
        end
        local lhrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if not lhrp then return end

        _s.rbTarget = RB_GetBestTarget()
        local tgt = _s.rbTarget
        
        if not tgt then _s.csyncCF = nil; return end
        local tc = tgt.Character; local tr = tc and tc:FindFirstChild("HumanoidRootPart")
        local thead = tc and (tc:FindFirstChild("Head") or tr)
        if not tr or not thead then _s.csyncCF = nil; return end

        if Toggles.KnifeFarm.Value then
            local dist = Options.FarmDist.Value
            local behindPos = tr.Position - tr.CFrame.LookVector * dist + Vector3.new(0, 1.5, 0)
            local fakeCF = CFrame.new(behindPos, thead.Position)
            
            _s.csyncCF = fakeCF
            _s.csyncLV = (behindPos - (_s.rbLastFakePos or behindPos)) / dt
            _s.rbLastFakePos = behindPos
            
            RB_DoFire(thead)
            return 
        end

        if Toggles.Underground.Value then
            local d = Options.UndergroundDepth.Value
            local r = 3
            local ugPos = thead.Position - tr.CFrame.LookVector * r + Vector3.new(0, -d, 0)
            local ugCF = CFrame.new(ugPos, thead.Position)
            _s.csyncCF = ugCF; _s.csyncLV = (ugPos - (_s.rbLastFakePos or ugPos)) / dt; _s.rbLastFakePos = ugPos
            RB_DoFire(thead)
            return
        end

        if Toggles.OrbitMode.Value then
            local dist = Options.OrbitDist.Value
            local speed = Options.OrbitSpeed.Value
            _s.orbitAngle += dt * math.max(1, speed * 0.15)
            local orbitPos = thead.Position + Vector3.new(math.cos(_s.orbitAngle) * dist, 2, math.sin(_s.orbitAngle) * dist)
            local orbitCF = CFrame.new(orbitPos, thead.Position)
            _s.csyncCF = orbitCF; _s.csyncLV = (orbitPos - (_s.rbLastFakePos or orbitPos)) / dt; _s.rbLastFakePos = orbitPos
            RB_DoFire(thead)
            return
        end

        local modeVal = Options.MoveMode.Value
        local dirVector = -tr.CFrame.LookVector 
        if modeVal == "앞(Front)" then dirVector = tr.CFrame.LookVector
        elseif modeVal == "뒤(Back)" then dirVector = -tr.CFrame.LookVector
        elseif modeVal == "왼(Left)" then dirVector = -tr.CFrame.RightVector
        elseif modeVal == "오른(Right)" then dirVector = tr.CFrame.RightVector
        elseif modeVal == "위(Up)" then dirVector = Vector3.new(0, 1, 0)
        end

        local targetPos = thead.Position + dirVector * 3 + Vector3.new(0, 2, 0)
        local faceCF = CFrame.new(targetPos, thead.Position)

        if Toggles.AntiAim.Value then
            _s.aaPhase += dt * 20
            faceCF = faceCF * CFrame.Angles(0, math.rad(math.sin(_s.aaPhase) * 70), 0)
        end

        _s.csyncCF = faceCF
        _s.csyncLV = (targetPos - (_s.rbLastFakePos or targetPos)) / dt
        _s.rbLastFakePos = targetPos
        
        RB_DoFire(thead)
    end)
end

local function StopRageBot()
    _s.rbActive = false
    if _s.rbConn then _s.rbConn:Disconnect(); _s.rbConn = nil end
    DisableVoidCsync(); StopCsync(); DisableNoclip()
    _s.rbTarget = nil; _s.csyncCF = nil; _s.rbLastFakePos = nil
end

