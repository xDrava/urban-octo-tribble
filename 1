local PARTS = { "Head", "Torso", "UpperTorso", "HumanoidRootPart" }
local _losParams = RaycastParams.new()
_losParams.FilterType = Enum.RaycastFilterType.Exclude

local _RND_LO, _RND_HI, _RND_DLO, _RND_DHI = -2147483646, 2147483646, -1147483646, 1147483646
local function _rand(mi, ma, dmi, dma)
    local r = math.random(mi, ma)
    while r >= dmi and r <= dma do r = math.random(mi, ma) end
    return r
end
local function _fakev()
    return Vector3.new(_rand(_RND_LO, _RND_HI, _RND_DLO, _RND_DHI), _rand(_RND_LO, _RND_HI, _RND_DLO, _RND_DHI), _rand(_RND_LO, _RND_HI, _RND_DLO, _RND_DHI))
end
local function _voidBR()
    local n = math.random(_RND_LO, _RND_HI)
    while n >= _RND_DLO and n <= _RND_DHI do n = math.random(_RND_LO, _RND_HI) end
    return n
end

local function IsTeam(p)
    local c = p.Character; if not c then return false end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    return hrp ~= nil and hrp:FindFirstChild("TeammateLabel") ~= nil
end

local function PlayerIsDead(p)
    if not p then return true end
    local c = p.Character; if not c then return true end
    local h = c:FindFirstChild("Humanoid")
    return not h or h.Health <= 0 or not c:FindFirstChild("HumanoidRootPart")
end

local function ShouldSkip(p)
    if p == LP then return true end
    local c = p.Character; if not c then return true end
    local h = c:FindFirstChild("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not h or h.Health <= 0 or not hrp then return true end
    if IsTeam(p) then return true end
    
    if not Toggles.KnifeFarm.Value and Toggles.DangerAvoid.Value then
        local vms = WS:FindFirstChild("ViewModels")
        if vms then
            for _, m in vms:GetChildren() do
                if m:IsA("Model") then
                    local s  = m.Name
                    local sp = s:find(" - ", 1, true)
                    if sp and s:sub(1, sp - 1) == p.Name then
                        local w = s:sub(sp + 3):lower()
                        if w:find("katana") or w:find("riot") or w:find("shield") then return true end
                    end
                end
            end
        end
    end
    return false
end

local function RB_GetBestTarget()
    local lc = LP.Character; local lhrp = lc and lc:FindFirstChild("HumanoidRootPart")
    if not lhrp then return nil end
    local best, bestV = nil, math.huge
    local useHP = Options.TargetMode.Value == "체력 최소"
    for _, p in Players:GetPlayers() do
        if ShouldSkip(p) then continue end
        local c = p.Character; local hrp = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end
        local val = useHP and hum.Health or (hrp.Position - lhrp.Position).Magnitude
        if val < bestV then bestV = val; best = p end
    end
    return best
end

local function RB_PressKey(kc)
