Toggles.RageBot:OnChanged(function()
    if Toggles.RageBot.Value then StartRageBot() else StopRageBot() end
end)

Toggles.Noclip:OnChanged(function()
    if Toggles.Noclip.Value and _s.rbActive then EnableNoclip() else DisableNoclip() end
end)

Toggles.Csync:OnChanged(function()
    if Toggles.Csync.Value and _s.rbActive and not Toggles.VoidMode.Value then StartCsync() elseif not Toggles.Csync.Value and not Toggles.KnifeFarm.Value then StopCsync() end
end)

Toggles.KnifeFarm:OnChanged(function()
    if Toggles.KnifeFarm.Value then
        Toggles.Csync:SetValue(true)
        Toggles.VoidMode:SetValue(false)
        Toggles.Underground:SetValue(false)
        Toggles.OrbitMode:SetValue(false)
        if _s.rbActive then StartRageBot() end
    end
end)

Toggles.VoidMode:OnChanged(function()
    VoidHideTime:SetVisible(Toggles.VoidMode.Value)
    VoidShootTime:SetVisible(Toggles.VoidMode.Value)
    if Toggles.RageBot.Value then StartRageBot() end
end)

Toggles.Underground:OnChanged(function()
    UndergroundDepth:SetVisible(Toggles.Underground.Value)
    if Toggles.Underground.Value then 
        Toggles.OrbitMode:SetValue(false); Toggles.KnifeFarm:SetValue(false)
    end
end)

Toggles.OrbitMode:OnChanged(function()
    OrbitDist:SetVisible(Toggles.OrbitMode.Value)
    OrbitSpeed:SetVisible(Toggles.OrbitMode.Value)
    if Toggles.OrbitMode.Value then 
        Toggles.Underground:SetValue(false); Toggles.KnifeFarm:SetValue(false)
    end
end)

